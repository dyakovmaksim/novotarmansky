# Production env for docker-compose. Copy to .env on the server.
#
#   cp .env.production.example .env
#   nano .env                          # fill in real values
#   docker compose up -d --build
#
# .env is gitignored — never commit it.

# ─── Domain / URLs ───
# Single public site URL — frontend talks to ${SITE_URL}/api at runtime.
SITE_URL=https://your-domain.com

# ─── PostgreSQL ───
# Strong password matters: db is only reachable inside the docker network,
# but still, do not use 'postgres'. Generate with `openssl rand -base64 24`.
DB_USER=novotarmansky
DB_PASSWORD=change-me-strong-pass
DB_NAME=novotarmansky

# ─── House metadata ───
HOUSE_TITLE=Novotarmanskiy house
HOUSE_PRICE_PER_NIGHT=5000
SAUNA_PRICE=3000

# ─── Telegram bot ───
# After ANY token leak — rotate via @BotFather /revoke.
# Multiple admins: comma-separated, e.g. 111,222.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
