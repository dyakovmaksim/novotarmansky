generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Single-house listing — house metadata (title, price) lives in env, not DB.
// Bookings are standalone records: the admin gets a Telegram alert per row.
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Booking {
  id           String        @id @default(uuid())
  customerName String
  phone        String
  startDate    DateTime
  endDate      DateTime
  adults       Int           @default(1)
  children     Int           @default(0)
  hasSauna     Boolean       @default(false)
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
}

// Promotions are managed by the private Telegram admin bot and shown publicly
// on the website. Images live in the persistent uploads volume.
model Promotion {
  id          String   @id @default(uuid())
  title       String
  description String
  badge       String?
  validUntil  String   @default("бессрочно")
  imagePath   String
  createdAt   DateTime @default(now())
}
