# --- Database ---
# Split into parts for clarity. DATABASE_URL is composed via dotenv ${VAR}
# expansion (Prisma reads this file natively).
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=novotarmansky
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- HTTP server ---
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- House metadata (single-house listing) ---
# Frontend reads price/title via NUXT_PUBLIC_HOUSE_* / NUXT_PUBLIC_SAUNA_PRICE.
# Backend uses them to compute total price for Telegram notifications.
HOUSE_TITLE=Novotarmanskiy house
HOUSE_PRICE_PER_NIGHT=5000
SAUNA_PRICE=3000

# --- Telegram bot ---
# Get a token from @BotFather in Telegram, then set the chat id(s) of the
# admin(s) who should receive booking notifications and have access to /admin
# commands. Multiple IDs — comma-separated (e.g. 111,222).
# If TELEGRAM_ADMIN_CHAT_ID is empty, the bot listener will NOT start, but
# the REST API will still work.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
